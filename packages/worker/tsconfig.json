{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@api/*": ["./src/api/*"],
      "@shared/*": ["./shared/src/*"],
      "@ocr/*": ["./src/ocr-pipeline/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
